{
  "name": "@sparxie/valedictorian-connectors-core",
  "version": "0.1.0",
  "description": "Source-agnostic connector ABI for Valedictorian job sources.",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
