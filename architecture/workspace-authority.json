  "discoveryContract": {
    "portableFields": [
      "workspaceId",
      "name",
      "source",
      "authorityId",
      "authorityEpoch",
      "capability-document-version",
      "capability-states"
    ],
    "localOnlyFields": [
      "local-workspace-path"
    ],
    "managedServerFilesystemPathExposed": false,
    "discoveryGrantsWriteAuthority": false,
    "staleDiscoveryMutationBehavior": "authority_epoch_conflict"
  },
  "transferProtocol": {
    "states": [
      "idle",
      "prepared",
      "snapshot_staged",
      "source_fenced",
      "final_snapshot_verified",
      "activated",
      "source_retired",
      "aborted"
    ],
    "terminalStates": [
      "source_retired",
      "aborted"
    ],
    "failureBehavior": {
      "commandFailureAdvancesPhase": false,
      "ambiguousOutcome": "read-authenticated-receipt-before-retry",
      "failedBeforeFence": "source-remains-active-target-remains-candidate",
      "failedAfterFence": "both-remain-read-only-until-retry-or-explicit-abort",
      "failedAfterActivation": "target-remains-current-authority"
    },
    "transitions": [
      {
        "operation": "prepare",
        "from": [
          "idle"
        ],
        "to": "prepared",
        "receipt": "prepare-receipt"
      },
      {
        "operation": "stageSnapshot",
        "from": [
          "prepared"
        ],
        "to": "snapshot_staged",
        "receipt": "snapshot-import-receipt"
      },
      {
        "operation": "fenceSource",
        "from": [
          "snapshot_staged"
        ],
        "to": "source_fenced",
        "receipt": "fence-receipt"
      },
      {
        "operation": "verifyFinalSnapshot",
        "from": [
          "source_fenced"
        ],
        "to": "final_snapshot_verified",
        "receipt": "final-verification-receipt"
      },
      {
        "operation": "activateTarget",
        "from": [
          "final_snapshot_verified"
        ],
        "to": "activated",
        "receipt": "activation-receipt"
      },
      {
        "operation": "retireSource",
        "from": [
          "activated"
        ],
        "to": "source_retired",
        "receipt": "retirement-receipt"
      },
      {
        "operation": "abortBeforeFence",
        "from": [
          "prepared",
          "snapshot_staged"
        ],
        "to": "aborted",
        "receipt": "abort-receipt"
      },
      {
        "operation": "abortAfterFence",
        "from": [
          "source_fenced",
          "final_snapshot_verified"
        ],
        "to": "aborted",
        "receipt": "abort-and-source-unfence-receipt"
      }
    ],
    "authorityReplicaStates": [
      "active",
      "candidate",
      "fenced",
      "retired"
    ],
    "phases": [
      {
        "phase": "prepared",
        "sourceState": "active",
        "targetState": "candidate",
        "sourceWritable": true,
        "targetWritable": false,
        "requiredEvidence": [
          "source-and-target-capabilities",
          "stable-workspace-identity",
          "current-authority-epoch",
          "destination-byok-proof-if-required"
        ]
      },
      {
        "phase": "snapshot_staged",
        "sourceState": "active",
        "targetState": "candidate",
        "sourceWritable": true,
        "targetWritable": false,
        "requiredEvidence": [
          "base-snapshot-manifest",
          "content-digests",
          "schema-and-capability-compatibility",
          "target-import-receipt"
        ]
      },
      {
        "phase": "source_fenced",
        "sourceState": "fenced",
        "targetState": "candidate",
        "sourceWritable": false,
        "targetWritable": false,
        "requiredEvidence": [
          "fence-receipt",
          "drained-inflight-mutations",
          "final-snapshot-at-fence-token"
        ]
      },
      {
        "phase": "final_snapshot_verified",
        "sourceState": "fenced",
        "targetState": "candidate",
        "sourceWritable": false,
        "targetWritable": false,
        "requiredEvidence": [
          "final-snapshot-digest",
          "identity-count-file-integrity-reconciliation",
          "secret-envelope-and-byok-proof",
          "target-restore-readback"
        ]
      },
      {
        "phase": "activated",
        "sourceState": "fenced",
        "targetState": "active",
        "sourceWritable": false,
        "targetWritable": true,
        "requiredEvidence": [
          "activation-receipt",
          "authority-epoch-increment",
          "target-health-and-discovery-readback",
          "source-write-rejection-readback"
        ]
      },
      {
        "phase": "source_retired",
        "sourceState": "retired",
        "targetState": "active",
        "sourceWritable": false,
        "targetWritable": true,
        "requiredEvidence": [
          "rollback-window-complete",
          "retention-and-backup-approval",
          "retirement-receipt",
          "no-routing-or-authority-readback"
        ]
      }
    ],
    "stateMatrix": [
      {
        "state": "idle",
        "sourceState": "active",
        "targetState": "absent",
        "sourceWritable": true,
        "targetWritable": false
      },
      {
        "state": "prepared",
        "sourceState": "active",
        "targetState": "candidate",
        "sourceWritable": true,
        "targetWritable": false
      },
      {
        "state": "snapshot_staged",
        "sourceState": "active",
        "targetState": "candidate",
        "sourceWritable": true,
        "targetWritable": false
      },
      {
        "state": "source_fenced",
        "sourceState": "fenced",
        "targetState": "candidate",
        "sourceWritable": false,
        "targetWritable": false
      },
      {
        "state": "final_snapshot_verified",
        "sourceState": "fenced",
        "targetState": "candidate",
        "sourceWritable": false,
        "targetWritable": false
      },
      {
        "state": "activated",
        "sourceState": "fenced",
        "targetState": "active",
        "sourceWritable": false,
        "targetWritable": true
      },
      {
        "state": "source_retired",
        "sourceState": "retired",
