{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Maintained tests import sibling `.mjs` proof scripts. Resolving them keeps
    // their call sites typed without checking the JavaScript itself.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["electron", "scripts", "src", "vite.config.ts"],
  "exclude": []
}
