{
  "name": "valedictorian-app",
  "private": true,
  "version": "0.1.0-alpha.55",
  "description": "Local job application tracker and agent access app.",
  "author": "Keni",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/run-supervised.ts dev",
    "dev:isolated": "tsx scripts/run-supervised.ts validation",
    "proof:dev": "tsx scripts/run-cli-ui-dev-proof.ts",
    "proof:electron": "tsx scripts/run-electron-native-ui-proof.ts",
    "validate:app": "tsx scripts/run-supervised.ts validation",
    "validate:isolated": "tsx scripts/run-isolated-validation.ts",
    "build": "pnpm run typecheck && vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac --publish never",
    "build:connector-packages": "pnpm --filter @sparxie/valedictorian-connectors-core run build && pnpm --filter @sparxie/valedictorian-connectors-test-harness run build",
    "build:workspace-packages": "pnpm --filter @sparxie/valedictorian-workspace-server run build && pnpm --filter @sparxie/valedictorian-workspace-server run generate && pnpm --filter @sparxie/valedictorian-workspace-client run build && pnpm --filter @sparxie/valedictorian-workspace-conformance run build",
    "lint": "pnpm run typecheck && pnpm run typecheck:tests && pnpm run peers:check && pnpm run audit:high && pnpm run lint:line-limit-policy && pnpm run lint:profile-secret-import-policy && pnpm run architecture:check && pnpm run lint:source-execution-ownership && pnpm run lint:connector-row-flow && pnpm run inspect:pglite-runtime && oxlint electron packages/connector-api packages/connector-testkit packages/workspace/server packages/workspace/client packages/workspace/conformance scripts src vite.config.ts --react-plugin --type-aware --report-unused-disable-directives --deny-warnings",
    "audit:high": "pnpm run proof:brace-expansion-patch && pnpm audit --audit-level high",
    "proof:brace-expansion-patch": "node scripts/brace-expansion-patch-proof.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "lint:line-limit-policy": "node scripts/line-limit-policy.mjs",
    "lint:profile-secret-import-policy": "node scripts/profile-secret-import-policy.mjs",
    "lint:source-execution-ownership": "node scripts/source-execution-ownership-proof.mjs",
    "peers:check": "pnpm peers check",
    "inspect:electron-runtime": "node scripts/inspect-electron-runtime.mjs",
    "inspect:pglite-runtime": "node scripts/inspect-pglite-runtime.mjs",
    "smoke:connector-modal-scroll": "node scripts/run-connector-modal-scroll-probe.mjs",
    "smoke:capture-completion-dialog-layout": "tsx scripts/run-electron-native-ui-proof.ts --capture-completion-layout",
    "smoke:manual-workflow-package": "node scripts/run-packaged-manual-workflow-proof.mjs",
    "smoke:pglite-package": "node scripts/run-packaged-pglite-smoke.mjs",
    "preview": "vite preview",
    "pretest": "pnpm run build:connector-packages && pnpm run build:workspace-packages",
    "test": "vitest run",
    "pretest:watch": "pnpm run build:connector-packages && pnpm run build:workspace-packages",
    "test:window": "VALEDICTORIAN_WINDOW_TESTS=1 pnpm test -- scripts/isolated-validation.command.test.ts",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @sparxie/valedictorian-workspace-server run build",
    "pretypecheck:tests": "pnpm run build:connector-packages && pnpm run build:workspace-packages",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsx scripts/maintained-test-typecheck-coverage.ts && tsc -p tsconfig.tests.json --noEmit",
    "db:generate": "tsx scripts/generate-database-baseline.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "lint:connector-row-flow": "node scripts/connector-row-flow-proof.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@sparxie/sdk": "0.36.0",
    "@sparxie/valedictorian-workspace-server": "workspace:0.1.0",
    "@sparxie/valedictorian-connectors-jobright": "0.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cosmiconfig": "9.0.2",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "env-paths": "^4.0.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.17.0",
    "pathe": "^2.0.3",
    "react": "^18.2.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "undici": "7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@sparxie/valedictorian-cli": "file:vendor/valedictorian-cli",
    "@sparxie/valedictorian-connectors-core": "0.19.0",
    "@sparxie/valedictorian-connectors-test-harness": "0.19.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.7",
    "es-module-lexer": "2.2.0",
    "js-yaml": "5.2.2",
    "jsdom": "^29.1.1",
    "lefthook": "2.1.10",
    "oxc-parser": "0.141.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "semver": "7.8.5",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.7"
  },
  "main": "dist-electron/main.js"
}
