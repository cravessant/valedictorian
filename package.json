{
  "name": "job-app",
  "private": true,
  "version": "0.0.0",
  "description": "Local job application tracker and agent access app.",
  "author": "Keni",
  "type": "module",
  "scripts": {
    "dev": "electron-builder install-app-deps && pnpm -C ../job-app-sdk build && vite",
    "build": "pnpm -C ../job-app-sdk build && tsc && vite build && electron-builder && NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3",
    "lint": "pnpm -C ../job-app-sdk build && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "pnpm -C ../job-app-sdk build && NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3 && vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3 && tsx scripts/migrate.ts",
    "rebuild:native": "electron-builder install-app-deps",
    "rebuild:node": "NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "job-app-sdk": "workspace:*",
    "lucide-react": "^1.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "prebuild-install": "^7.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/main.js"
}
