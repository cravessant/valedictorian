{
  "name": "valedictorian-app",
  "private": true,
  "version": "0.1.0-alpha.18",
  "description": "Local job application tracker and agent access app.",
  "author": "Keni",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-builder install-app-deps && vite",
    "build": "pnpm run typecheck && vite build && electron-builder && NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3",
    "build:mac": "vite build && electron-builder --mac --publish never && NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3",
    "lint": "pnpm run typecheck && oxlint . --react-plugin --type-aware --report-unused-disable-directives --deny-warnings",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=\"--disable-warning=DEP0176 --disable-warning=DEP0205\" pnpm rebuild better-sqlite3 && NODE_OPTIONS=\"--disable-warning=DEP0176 --disable-warning=DEP0205\" vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3 && tsx scripts/migrate.ts",
    "rebuild:native": "electron-builder install-app-deps",
    "rebuild:node": "NODE_OPTIONS=--disable-warning=DEP0176 pnpm rebuild better-sqlite3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "better-sqlite3": "^12.10.0",
    "bindings": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cosmiconfig": "9.0.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "env-paths": "^4.0.0",
    "file-uri-to-path": "^1.0.0",
    "lucide-react": "^1.17.0",
    "pathe": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sparxie": "0.5.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "umzug": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "prebuild-install": "^7.1.3",
    "tsx": "^4.22.4",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/main.js"
}
