{
  "name": "valedictorian-app",
  "private": true,
  "version": "0.1.0-alpha.46",
  "description": "Local job application tracker and agent access app.",
  "author": "Keni",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/run-supervised.ts dev",
    "validate:app": "tsx scripts/run-supervised.ts validation",
    "build": "pnpm run typecheck && vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac --publish never",
    "lint": "pnpm run typecheck && pnpm run lint:line-limit-policy && pnpm run lint:profile-secret-import-policy && pnpm run lint:pglite-cutover-policy && oxlint . --react-plugin --type-aware --report-unused-disable-directives --deny-warnings",
    "lint:line-limit-policy": "node scripts/line-limit-policy.mjs",
    "lint:profile-secret-import-policy": "node scripts/profile-secret-import-policy.mjs",
    "lint:pglite-cutover-policy": "node scripts/pglite-cutover-policy.mjs",
    "inspect:pglite-runtime": "node scripts/inspect-pglite-runtime-assets.mjs",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=\"--disable-warning=DEP0176 --disable-warning=DEP0205\" vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@sparxie/valedictorian-connectors-jobright": "0.15.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "better-sqlite3": "^12.10.0",
    "bindings": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cosmiconfig": "9.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "env-paths": "^4.0.0",
    "file-uri-to-path": "^1.0.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.17.0",
    "pathe": "^2.0.3",
    "react": "^18.2.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "sparxie": "0.24.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "umzug": "^3.8.3",
    "undici": "7.27.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sparxie/valedictorian-connectors-core": "0.15.0",
    "@sparxie/valedictorian-connectors-test-harness": "0.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "prebuild-install": "^7.1.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/main.js"
}
